APP_NAME=NutriLife
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# NutriLife usa MySQL 8 / MariaDB 10.4+ con la base `nutrilife`.
# XAMPP usa el puerto 3306 por defecto; cámbialo si tu MySQL usa otro (p. ej. 3307).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nutrilife
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Correo de contacto público de la landing (vacío = no se muestra)
NUTRILIFE_CONTACT_EMAIL=

# --- NutriLife (actualización 3.1) ---
# Zona horaria de "hoy", la agenda, la prueba y la activación de cuentas
APP_TIMEZONE=America/Mexico_City
# Días de prueba gratuita (empieza cuando la cuenta se activa)
NUTRILIFE_TRIAL_DAYS=7
# Minutos que tarda en habilitarse una cuenta nueva del registro público
# (simulación). Es el ÚNICO lugar donde se cambia: lo lee
# config/nutrilife.php → account_activation.delay_minutes y lo usa
# App\Services\AccountActivation. 1 = un minuto, 5 = cinco, 10 = diez,
# 0 = inmediato. Se aplica a los registros NUEVOS (la hora se guarda en
# users.activates_at al registrarse); las cuentas que ya esperan conservan
# su hora. Con `php artisan config:cache`, vuelve a ejecutarlo tras cambiarlo.
NUTRILIFE_ACTIVATION_DELAY_MINUTES=5
# Contratación simulada de paquetes (no hay pasarela de pago)
NUTRILIFE_SIMULATED_PAYMENTS=true

# --- NutriLife (actualización 4: consultorios y administrador global) ---
# "Verificado (simulado)" en Mi perfil sin llenar email_verified_at.
# Solo visual y nunca con APP_ENV=production.
NUTRILIFE_SIMULATED_EMAIL_VERIFICATION=false
# Límite de subperfiles de nutriólogo por clínica (vacío = sin límite)
NUTRILIFE_CLINIC_MAX_MEMBERS=
# Proxies de confianza (túnel HTTPS como cloudflared o ngrok en la misma
# máquina). Por defecto solo localhost; evita el "419 Page Expired" al
# usar el túnel. Separa varios con comas.
TRUSTED_PROXIES=127.0.0.1,::1
